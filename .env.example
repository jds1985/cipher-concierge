# Copy to .env.local. Never commit real values.
# HMAC secret for room QR tokens (32+ random chars). Generate: openssl rand -base64 48
QR_SECRET=
# Bump to invalidate every printed QR card at once
QR_KEY_VERSION=1
# Required for /admin/hotels (create hotel) and legacy /admin/qr. Prefer header/body, not URL.
ADMIN_KEY=
# Public URL encoded into QR codes
PUBLIC_BASE_URL=http://localhost:3000
# Local Cipher 2.0 server (cipher-serve). Not used on Vercel (no always-on process).
CIPHER_URL=http://127.0.0.1:8899/v1/chat/completions
CIPHER_MODEL=cipher-2.0
# "off" = open (non-fact) questions go straight to the front desk (recommended until the 369M model)
CIPHER_OPEN_QUESTIONS=on
# "off" = server path never calls cipher-serve (required on Vercel; on-phone WASM still works)
CIPHER_SERVER_MODEL=off
# 1 = enable the public /demo launcher (hands out signed demo-room links)
DEMO_MODE=1
# Optional override for build-time model download (defaults to the model-sft-135m GitHub release)
# CIPHER_MODEL_URL=https://github.com/jds1985/cipher-concierge/releases/download/model-sft-135m/sft.ctern

# Upstash Redis / Vercel KV (free tier) for hotel self-setup storage.
# Connected via `vercel storage` / Upstash; Redis.fromEnv reads either pair:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Without these, self-setup uses an in-memory store (local/tests only; not durable across instances).
