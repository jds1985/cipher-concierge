# Copy to .env.local. Never commit real values.
# HMAC secret for room QR tokens (32+ random chars). Generate: openssl rand -base64 48
QR_SECRET=
# Bump to invalidate every printed QR card at once
QR_KEY_VERSION=1
# Required to open /admin/qr?key=... in production
ADMIN_KEY=
# Public URL encoded into QR codes
PUBLIC_BASE_URL=http://localhost:3000
# Local Cipher 2.0 server (cipher-serve). No other AI endpoint is supported.
CIPHER_URL=http://127.0.0.1:8899/v1/chat/completions
CIPHER_MODEL=cipher-2.0
# "off" = open (non-fact) questions go straight to the front desk (recommended until the 369M model)
CIPHER_OPEN_QUESTIONS=on
# 1 = enable the public /demo launcher (hands out signed demo-room links)
DEMO_MODE=1
